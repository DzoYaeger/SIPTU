<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Biarkan folder core_api diakses secara normal (jangan ditarik ke React)
  RewriteCond %{REQUEST_URI} ^/core_api/ [NC]
  RewriteRule .* - [L]

  # 2. Sisanya untuk React SPA
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # ── Security Headers ──────────────────────────────────────────
  # Anti Clickjacking: cegah halaman di-frame situs lain
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # MIME sniffing protection
  Header always set X-Content-Type-Options "nosniff"

  # HTTPS enforcement (HSTS) — hanya aman karena domain full HTTPS via Cloudflare
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Batasi fitur browser yang tidak digunakan (kamera/mikro/lokasi)
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # ── Cache Control aset statis (performa) ─────────────────────
  <FilesMatch "\.(js|css|woff2?|eot|ttf|otf|png|jpg|jpeg|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|manifest\.json|sw\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ── Kompresi (performa) ─────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>
